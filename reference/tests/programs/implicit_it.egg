# `it` is the parameter of a one-parameter lambda
let doubled = [1, 2, 3].map(it * 2).to_list()
let firsts = ["2-4,6-8", "5-7,7-9"].map(it.ints().first()).to_list()
# nested: the inner `it` belongs to the innermost lambda-taking call
let with_a = ["abc", "xyz", "bar"].filter(it.chars().any(it == 'a')).count()
let sorted = [3, 1, 2].to_sorted(by = -it)
# count(x) still counts values; with `it` it takes a predicate
let big = [1, 5, 7, 2].count(it > 4)
let ones = [1, 5, 1].count(1)
fun twice(n: int) -> int:
  n * 2
let calls = (1..=3).map(twice(it)).sum()
(doubled, firsts, with_a, sorted, big, ones, calls)
