let mask = 0
for k in [0, 3, 5]:
  mask |= 1 << k
let has3 = mask & (1 << 3) != 0
mask ^= 1 << 3
let x = 6
x <<= 2
x >>= 1
x &= 7
# `>>` closing two type parameter lists still parses
fun groups(m: Map<string, Set<int>>) -> int:
  m.len()
(mask, has3, 5 ^ 3, 1 << 2 + 1, -16 >> 2, x, 12 & 10 | 1, "ff".int(base = 16), "-101".int(base = 2), "7Z".int(base = 36), groups(Map()))
