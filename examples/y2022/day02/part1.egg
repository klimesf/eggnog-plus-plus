fun eval_round(line: string) -> int:
  match line:
    "A X": 1 + 3
    "A Y": 2 + 6
    "A Z": 3 + 0
    "B X": 1 + 0
    "B Y": 2 + 3
    "B Z": 3 + 6
    "C X": 1 + 6
    "C Y": 2 + 0
    "C Z": 3 + 3
    _: panic("unknown combination")

input.lines()
  .map(line => eval_round(line))
  .sum()

test """
A Y
B X
C Z
""" == 15
