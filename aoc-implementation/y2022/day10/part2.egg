let instructions = input.lines().to_list()
let ptr = 0
let executing = false
let x = 1
let crt = ""

for cycle in 0..240:
  let pixel = cycle % 40
  if pixel == 0 and cycle != 0: crt += "\n"
  crt += if pixel in [x - 1, x, x + 1] then "#" else "."

  if instructions[ptr] == "noop":
    ptr += 1
    continue

  if executing:
    x += instructions[ptr].ints().first()
    ptr += 1
  executing = !executing

crt

test file("test.txt") == """
##..##..##..##..##..##..##..##..##..##..
###...###...###...###...###...###...###.
####....####....####....####....####....
#####.....#####.....#####.....#####.....
######......######......######......####
#######.......#######.......#######.....
"""
test file("input.txt") == """
###..####.#..#.###..###..#....#..#.###..
#..#.#....#..#.#..#.#..#.#....#..#.#..#.
#..#.###..####.#..#.#..#.#....#..#.###..
###..#....#..#.###..###..#....#..#.#..#.
#.#..#....#..#.#....#.#..#....#..#.#..#.
#..#.####.#..#.#....#..#.####..##..###..
"""
