import parse_packet, compare from "packet.egg"

fun is_ordered(pair: string) -> bool:
  let (a, b) = pair.split_once("\n")
  compare(parse_packet(a), parse_packet(b)) <= 0

input.split("\n\n").enumerate()
  .filter((_, pair) => is_ordered(pair))
  .map((i, _) => i + 1)
  .sum()

test """
[1,1,3,1,1]
[1,1,5,1,1]

[[1],[2,3,4]]
[[1],4]

[9]
[[8,7,6]]

