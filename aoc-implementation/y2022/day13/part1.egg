enum Data:
  Integer(value: int)
  List(values: [Data])

fun parse(packet: string) -> Data:
  let stack = Stack()
  let list = []
  let num = ""
  for c in packet.chars():
    if c.is_digit():
      num += c
    else if c == ',':
      if num.len() > 0:
        list.push(Integer(num.int()))
        num = ""
    else if c == '[':
      stack.push(list)
      list = []
    else if c == ']':
      if num.len() > 0:
        list.push(Integer(num.int()))
        num = ""
      let closed = list
      list = stack.pop()
      list.push(List(closed))
  List(list)

fun compare(a: Data, b: Data) -> int:
  match (a, b):
    (Integer(x), Integer(y)): if x == y then 0 else if x < y then -1 else 1
    (Integer(_), List(_)): compare(List([a]), b)
    (List(_), Integer(_)): compare(a, List([b]))
    (List(x), List(y)):
      for i in 0..min(x.len(), y.len()):
        let cmp = compare(x[i], y[i])
        if cmp != 0: return cmp
      return if x.len() == y.len() then 0 else if x.len() < y.len() then -1 else 1

fun is_ordered(pair: string) -> bool:
  let (a, b) = pair.split_once("\n")
  compare(parse(a), parse(b)) <= 0

input.split("\n\n").enumerate()
  .filter((_, pair) => is_ordered(pair))
  .map((i, _) => i + 1)
  .sum()

