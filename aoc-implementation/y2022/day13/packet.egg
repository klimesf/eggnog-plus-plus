enum Data:
  Integer(value: int)
  List(values: [Data])

fun parse(packet: string, inout at: int) -> Data:
  if packet[at].is_digit():
    let from = at
    while packet[at].is_digit(): at += 1
    return Integer(packet[from..at].int())

  at += 1 # opening '['
  let list = []
  while packet[at] != ']':
    list.push(parse(packet, &at))
    if packet[at] == ',': at += 1
  at += 1 # closing ']'
  List(list)

fun parse_packet(packet: string) -> Data:
  let start = 0
  parse(packet, &start)

fun compare(a: Data, b: Data) -> int:
  match (a, b):
    (Integer(x), Integer(y)): if x == y then 0 else if x < y then -1 else 1
    (Integer(_), List(_)): compare(List([a]), b)
    (List(_), Integer(_)): compare(a, List([b]))
    (List(x), List(y)):
      for i in 0..min(x.len(), y.len()):
        let cmp = compare(x[i], y[i])
        if cmp != 0: return cmp
      return compare(Integer(x.len()), Integer(y.len()))

test "parse packet":
  assert parse_packet("[]") == List([])
  assert parse_packet("[1]") == List([Integer(1)])

test "compare":
  assert compare(parse_packet("[1,1,3,1,1]"), parse_packet("[1,1,5,1,1]")) == -1
  assert compare(parse_packet("[]"), parse_packet("[3]")) == -1
  assert compare(parse_packet("[7,7,7,7]"), parse_packet("[7,7,7]")) == 1
