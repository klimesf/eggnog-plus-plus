let head = (0, 0)
let tail = (0, 0)
let visited = Set(tail)

fun follow():
  let (dr, dc) = head - tail
  if head == tail or (dr, dc) in Dirs8: return
  if dr != 0: tail += if dr < 0 then Up else Down
  if dc != 0: tail += if dc < 0 then Left else Right
  visited.add(tail)

for line in input.lines():
  let (dir, steps) = line.split_once(" ")
  let step = match dir:
    "U": Up
    "R": Right
    "D": Down
    "L": Left
  for _ in 0..steps.int():
    head += step
    follow()

visited.len()

test """
R 4
U 4
L 3
D 1
R 4
D 1
L 5
R 2
""" == 13
test file("input.txt") == 5619
