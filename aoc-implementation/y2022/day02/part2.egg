fun eval_round(line: string) -> int:
  match line:
    "A X": 3 + 0
    "A Y": 1 + 3
    "A Z": 2 + 6
    "B X": 1 + 0
    "B Y": 2 + 3
    "B Z": 3 + 6
    "C X": 2 + 0
    "C Y": 3 + 3
    "C Z": 1 + 6
    _: panic("unknown combination")

input.lines()
  .map(eval_round(it))
  .sum()

test """
A Y
B X
C Z
""" == 12
test file("input.txt") == 15457
