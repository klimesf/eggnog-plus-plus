fun priority(c: char) -> int:
  if c >= 'a' and c <= 'z' then c - 'a' + 1 else c - 'A' + 27

input.lines()
  .chunks(3)
  .map([a, b, c] => a.chars().intersection(b).intersection(c).first())
  .map(priority(it))
  .sum()

test """
vJrwpWtwJgWrhcsFMMfFFhFp
jqHRNqRjqzjGDLGLrsFMfFZSrLrFZsSL
PmmdzqPrVvPwwTWBwg
wMqvLMZHhHMvwLHjbvcjnnSBnvTQFn
ttgJtRGJQctTZtZT
CrZsJsPPZsGzwwsLwLmpwMDw
""" == 70
test file("input.txt") == 2821
