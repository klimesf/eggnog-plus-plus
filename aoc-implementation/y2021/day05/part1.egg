let counts = Map(default = 0)

for vent in input.lines():
  let [x1, y1, x2, y2] = vent.ints().to_list()
  if x1 == x2: for y in min(y1, y2)..=max(y1, y2): counts[(x1, y)] += 1
  if y1 == y2: for x in min(x1, x2)..=max(x1, x2): counts[(x, y1)] += 1

counts.values().count(it > 1)

test """
0,9 -> 5,9
8,0 -> 0,8
9,4 -> 3,4
2,2 -> 2,1
7,0 -> 7,4
6,4 -> 2,0
0,9 -> 2,9
3,4 -> 1,4
0,0 -> 8,8
5,5 -> 8,2
""" == 5
test file("input.txt") == 8060
