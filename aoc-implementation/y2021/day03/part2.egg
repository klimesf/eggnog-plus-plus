fun oxygen_generator_rating(numbers: [string], pos: int) -> int:
  if numbers.len() == 1: return numbers.first().int(base = 2)
  let zeroes = numbers.map(it[pos]).count(it == '0')
  let ones = numbers.len() - zeroes
  let cmp = if zeroes > ones then '0' else '1'
  let keep = numbers.filter(it[pos] == cmp).to_list()
  oxygen_generator_rating(keep, pos + 1)

fun co2_scubber_rating(numbers: [string], pos: int) -> int:
  if numbers.len() == 1: return numbers.first().int(base = 2)
  let zeroes = numbers.map(it[pos]).count(it == '0')
  let ones = numbers.len() - zeroes
  let cmp = if zeroes > ones then '1' else '0'
  let keep = numbers.filter(it[pos] == cmp).to_list()
  co2_scubber_rating(keep, pos + 1)

let numbers = input.lines().to_list()
oxygen_generator_rating(numbers, 0) * co2_scubber_rating(numbers, 0)

test """
00100
11110
10110
10111
10101
01111
00111
11100
10000
11001
00010
01010
""" == 230
test file("input.txt") == 793873
