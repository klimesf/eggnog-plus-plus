let gamma = ""
let epsilon = ""

let numbers = input.lines().to_list()
for i in 0..numbers[0].len():
  let zeroes = numbers.map(it[i]).count(it == '0')
  let ones = numbers.len() - zeroes
  gamma += if zeroes > ones then "0" else "1"
  epsilon += if zeroes > ones then "1" else "0"

gamma.int(base = 2) * epsilon.int(base = 2)

test """
00100
11110
10110
10111
10101
01111
00111
11100
10000
11001
00010
01010
""" == 198
test file("input.txt") == 1025636
