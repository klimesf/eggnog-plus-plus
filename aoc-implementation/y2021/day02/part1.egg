let horizontal = 0
let depth = 0

for line in input.lines():
  if line.starts_with("forward"): horizontal += line[8..].int()
  else if line.starts_with("down"): depth += line[5..].int()
  else: depth -= line[3..].int()

horizontal * depth

test """
forward 5
down 5
forward 8
up 3
down 8
forward 2
""" == 150
test file("input.txt") == 2187380
