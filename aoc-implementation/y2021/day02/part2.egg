let horizontal = 0
let depth = 0
let aim = 0

for line in input.lines():
  if line.starts_with("forward"):
    let x = line[8..].int()
    horizontal += x
    depth += aim * x
  else if line.starts_with("down"): aim += line[5..].int()
  else: aim -= line[3..].int()

horizontal * depth

test """
forward 5
down 5
forward 8
up 3
down 8
forward 2
""" == 900
test file("input.txt") == 2086357770
