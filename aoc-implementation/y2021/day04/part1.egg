let (numbers, grids) = input.split_once("\n\n")
let numbers = numbers.ints().to_list()
let grids = grids.split("\n\n")
  .map(grid => grid.lines().map(it.ints().to_list()).to_list())
  .to_list()

for num in numbers:
  for i in 0..grids.len():
    for r in 0..5:
      for c in 0..5:
        if grids[i][r][c] == num: grids[i][r][c] = 0
        if (0..5).any(r => grids[i][r].all(it == 0)) or (0..5).any(c => (0..5).all(grids[i][it][c] == 0)):
          return num * grids[i].map(it.sum()).sum()

test """
7,4,9,5,11,17,23,2,0,14,21,24,10,16,13,6,15,25,12,22,18,20,8,19,3,26,1

