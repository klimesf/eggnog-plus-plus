let (rules, updates) = input.split_once("\n\n")

let predecessors = Map(default = Set())
for (before, after) in rules.lines().map(it.split_once("|")):
  predecessors[after.int()].add(before.int())

fun correctly_ordered(update: [int]) -> bool:
  (0..update.len()).all(update[it + 1..].intersection(predecessors[update[it]]).is_empty())

updates.lines()
  .map(it.ints().to_list())
  .filter(correctly_ordered(it))
  .map(it[it.len() / 2])
  .sum()

