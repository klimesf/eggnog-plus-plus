enum State:
  Disabled
  Enabled
  First
  Second

let p = 0
let state = Enabled
let left = 0
let right = 0
let total = 0

fun reset():
  state = Enabled
  left = 0
  right = 0

while p < input.len():
  if input[p..].starts_with("don't()"):
    state = Disabled
    p += 7
    left = 0
    right = 0
    continue

  match state:
    Disabled:
      if input[p..].starts_with("do()"):
        state = Enabled
        p += 4
      else: p += 1
    Enabled:
      if input[p..].starts_with("mul("):
        state = First
        p += 4
      else: p += 1
    First:
      if input[p].is_digit(): left = left * 10 + input[p].digit()
      else if input[p] == ',': state = Second
      else: reset()
      p += 1
    Second:
      if input[p].is_digit(): right = right * 10 + input[p].digit()
      else:
        if input[p] == ')': total += left * right
        reset()
      p += 1

total

test "xmul(2,4)&mul[3,7]!^don't()_mul(5,5)+mul(32,64](mul(11,8)undo()?mul(8,5))" == 48
test file("input.txt") == 89798695
