fun safety_factor(robots: string, width: int, height: int) -> int:
  let quadrants = Map(default = 0)
  for [x, y, vx, vy] in robots.lines().map(it.ints().to_list()):
    let x = (x + 100 * vx) % width
    let y = (y + 100 * vy) % height
    if x != width / 2 and y != height / 2: quadrants[(x < width / 2, y < height / 2)] += 1
  quadrants.values().product()

safety_factor(input, 101, 103)

test "safety factor":
  let robots = """
  p=0,4 v=3,-3
  p=6,3 v=-1,-3
  p=10,3 v=-1,2
  p=2,0 v=2,-1
  p=0,0 v=1,3
  p=3,0 v=-2,-2
  p=7,6 v=-1,-3
  p=3,0 v=-1,-2
  p=9,3 v=2,3
  p=7,3 v=-1,2
  p=2,4 v=2,-3
  p=9,5 v=-3,-3
  """
  assert safety_factor(robots, 11, 7) == 12
test file("input.txt") == 222901875
