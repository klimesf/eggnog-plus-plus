fun possible(test_value: int, numbers: [int]) -> bool:
  fun reachable(so_far: int, pos: int) -> bool:
    if pos >= numbers.len(): return so_far == test_value
    if so_far > test_value: return false
    let n = numbers[pos]
    reachable(so_far + n, pos + 1) or reachable(so_far * n, pos + 1)
  reachable(numbers[0], 1)

input.lines()
  .map(it.ints().to_list())
  .filter(possible(it[0], it[1..]))
  .map(it[0])
  .sum()

test """
190: 10 19
3267: 81 40 27
83: 17 5
156: 15 6
7290: 6 8 6 15
161011: 16 10 13
192: 17 8 14
21037: 9 7 18 13
292: 11 6 16 20
""" == 3749
test file("input.txt") == 20665830408335
