import cramer from "../../algebra.egg"

fun tokens(machine: string) -> int:
  let [ax, ay, bx, by, px, py] = machine.ints().to_list()
  let (d, da, db) = cramer(ax, bx, px + 10000000000000, ay, by, py + 10000000000000)
  if da % abs(d) != 0 or db % abs(d) != 0: return 0 # only integer solutions allowed
  let a = da / d
  let b = db / d
  if a < 0 or b < 0: return 0
  a * 3 + b

input
  .split("\n\n")
  .map(tokens(it))
  .sum()

test """
Button A: X+94, Y+34
Button B: X+22, Y+67
Prize: X=8400, Y=5400

