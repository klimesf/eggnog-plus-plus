fun path_exists(bytes: [string], size: int) -> bool:
  let grid = Grid(size + 1, size + 1, '.')
  for [x, y] in bytes.map(it.ints().to_list()): grid[(y, x)] = '#'
  let visited = Set()
  let queue = Queue(((0, 0), 0))
  while (pos, steps) = queue.pop():
    if pos !in grid or grid[pos] != '.' or !visited.add(pos): continue
    if pos == (size, size): return true
    for d in Dirs4: queue.push((pos + d, steps + 1))
  false

fun blocking_byte(bytes: [string], size: int) -> string:
  let (start, end) = (0, bytes.len() - 1) # assuming path always exists after first byte falls
  while end - start > 1:
    let middle = (end - start) / 2
    let fallen = bytes.take(start + middle).to_list()
    if path_exists(fallen, size): start = start + middle
    else: end = start + middle
  bytes[start]

blocking_byte(input.lines().to_list(), 70)

test "blocking byte":
  let bytes = """
  5,4
  4,2
  4,5
  3,0
  2,1
  6,3
  2,4
  1,5
  0,6
  3,3
  2,6
  5,1
  1,2
  5,5
  2,5
  6,5
  1,4
  0,4
  6,4
  1,1
  6,1
  1,0
  0,5
  1,6
  2,0
  """
  assert blocking_byte(bytes.lines().to_list(), 6) == "6,1"

test file("input.txt") == "30,12"
