let grid = input.to_char_grid()

let frequencies = Map(default = [])
for p in grid.positions().filter(grid[it] != '.'): frequencies[grid[p]].push(p)

let antinodes = Set()
for antennas in frequencies.values():
  for [a, b] in antennas.combinations(2):
    let (r, c) = b - a
    let divisor = gcd(r, c)
    let vec = (r / divisor, c / divisor)
    let pos = b
    while pos in grid:
      antinodes.add(pos)
      pos += vec
    pos = b
    while pos in grid:
      antinodes.add(pos)
      pos -= vec
antinodes.len()

test """
T.........
...T......
.T........
..........
..........
..........
..........
..........
..........
..........
""" == 9
