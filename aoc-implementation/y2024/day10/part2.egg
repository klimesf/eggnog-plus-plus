let grid = input.to_digit_grid()

let steps = grid.positions().filter(grid[it] == 0).to_list()
let sum = 0
while pos = steps.pop():
  if grid[pos] == 9:
    sum += 1
    continue
  for d in Dirs4:
    if pos + d !in grid or grid[pos + d] - grid[pos] != 1: continue
    steps.push(pos + d)
sum

