let (grid, instructions) = input.split_once("\n\n")
let grid = grid.to_char_grid()

let robot = grid.find('@')
for instruction in instructions.chars().filter(it != '\n'):
  let dir = match instruction:
    '^': Up
    '>': Right
    'v': Down
    '<': Left

  let end = robot + dir

  while grid[end] == 'O': end += dir
  if grid[end] == '#': continue

  while end != robot:
    grid[end] = grid[end - dir]
    end -= dir

  grid[robot] = '.'
  robot += dir

grid.positions()
  .filter(grid[it] == 'O')
  .map((r, c) => 100 * r + c)
  .sum()

test """
########
#..O.O.#
##@.O..#
#...O..#
#.#.O..#
#...O..#
#......#
########

<^^>>>vv<v>>v<<
""" == 2028
