let grid = input.to_char_grid()

fun xmas(r: int, c: int) -> bool:
  if grid[(r, c)] != 'A': return false
  let neighbors = [grid[(r - 1, c - 1)], grid[(r - 1, c + 1)], grid[(r + 1, c - 1)], grid[(r + 1, c + 1)]]
  neighbors in [['M', 'M', 'S', 'S'], ['M', 'S', 'M', 'S'], ['S', 'M', 'S', 'M'], ['S', 'S', 'M', 'M']]

let count = 0
for r in 1..grid.rows() - 1:
  for c in 1..grid.cols() - 1:
    if xmas(r, c): count += 1
count

test """
MMMSXXMASM
MSAMXMSMSA
AMXSXMAAMM
MSAMASMSMX
XMASAMXAMM
XXAMMXXAMA
SMSMSASXSS
SAXAMASAAA
MAMMMXMMMM
MXMXAXMASX
""" == 9
test file("input.txt") == 1941
