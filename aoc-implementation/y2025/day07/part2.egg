let grid = input.to_char_grid()

memo fun timelines(pos: (int, int)) -> int:
  if pos !in grid: return 1
  if grid[pos] != '^': return timelines(pos + Down)
  timelines(pos + Left) + timelines(pos + Right)

timelines(grid.find('S'))

test """
.......S.......
...............
.......^.......
...............
......^.^......
...............
.....^.^.^.....
...............
....^.^...^....
...............
...^.^...^.^...
...............
..^...^.....^..
...............
.^.^.^.^.^...^.
...............
""" == 40
