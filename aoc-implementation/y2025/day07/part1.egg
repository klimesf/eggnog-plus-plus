let grid = input.to_char_grid()

let beams = Stack(grid.find('S'))
let splits = 0
let visited = Set()
while pos = beams.pop():
  if pos !in grid or !visited.add(pos): continue
  if grid[pos] == '^':
    beams.push(pos + Left)
    beams.push(pos + Right)
    splits += 1
  else: beams.push(pos + Down)
splits

test """
.......S.......
...............
.......^.......
...............
......^.^......
...............
.....^.^.^.....
...............
....^.^...^....
...............
...^.^...^.^...
...............
..^...^.....^..
...............
.^.^.^.^.^...^.
...............
""" == 21
test file("input.txt") == 1605
