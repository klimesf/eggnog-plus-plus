fun invalid_ids(a: int, b: int) -> [int]:
  let digits = a.digits().count()
  let half = if digits % 2 == 0 then a / pow(10, digits / 2) else pow(10, digits / 2)

  let ids = []
  while true:
    let id = half * pow(10, half.digits().count()) + half
    if id > b: break
    if id >= a: ids.push(id)
    half += 1
  ids

input.split(",")
  .map(it.ints().to_list())
  .flat_map([a, b] => invalid_ids(a, b))
  .sum()

test """11-22,95-115,998-1012,1188511880-1188511890,222220-222224,1698522-1698528,446443-446449,38593856-38593862,565653-565659,824824821-824824827,2121212118-2121212124""" == 1227775554
