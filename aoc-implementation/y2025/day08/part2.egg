let boxes = input.lines().map(it.ints().to_list()).to_list()
let shortest = MinQueue()
for i in 0..boxes.len():
  let [xi, yi, zi] = boxes[i]
  for j in i + 1..boxes.len():
    let [xj, yj, zj] = boxes[j]
    shortest.push((i, j), pow(xi - xj, 2) + pow(yi - yj, 2) + pow(zi - zj, 2))

let circuits = (0..boxes.len()).to_list()
let count = circuits.len()
while true:
  let ((i, j), _) = shortest.pop()
  let (old, new) = (circuits[j], circuits[i])
  if old == new: continue
  for k in 0..boxes.len(): if circuits[k] == old: circuits[k] = new
  count -= 1
  if count == 1: return boxes[i][0] * boxes[j][0]

