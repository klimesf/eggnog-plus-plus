fun max_joltage(batteries: [int]) -> int:
  let i = (0..batteries.len() - 1)
    .to_sorted(by = batteries[it], desc = true)
    .first()
  let j = (i + 1..batteries.len())
    .to_sorted(by = batteries[it], desc = true)
    .first()
  batteries[i] * 10 + batteries[j]

input.lines()
  .map(it.digits().to_list())
  .map(max_joltage(it))
  .sum()

test """
987654321111111
811111111111119
234234234234278
818181911112111
""" == 357
test file("input.txt") == 17412
