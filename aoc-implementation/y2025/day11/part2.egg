let outputs = input.lines()
  .map(it.split_once(": "))
  .map((device, out) => (device, out.split(" ").to_list()))
  .to_map()

memo fun count_paths(device: string, dest: string) -> int:
  if device == dest: return 1
  if device !in outputs: return 0
  outputs[device].map(count_paths(it, dest)).sum()

# by analysing the input I found out that there are no cycles
# the order is svr -> fft -> dac -> out and both dac and fft splits the path only in one way
# so I can split this into sub-problems and multiply
count_paths("svr", "fft") * count_paths("fft", "dac") * count_paths("dac", "out")

test """
svr: aaa bbb
aaa: fft
fft: ccc
bbb: tty
tty: ccc
ccc: ddd eee
ddd: hub
hub: fff
eee: dac
dac: fff
fff: ggg hhh
ggg: out
hhh: out
""" == 2
test file("input.txt") == 511378159390560
