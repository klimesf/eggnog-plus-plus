let total = 0
let i = 0
for line in input.lines():
  print(i)
  let parts = line.split(" ").to_list()
  let buttons = parts[1..parts.len() - 1].map(it.ints().to_list()).to_list()
  let target = parts.last().ints().to_list()

  let configurations = MinQueue([0] * target.len(), 0)
  let visited = Set()
  while (state, presses) = configurations.pop():
    if state == target:
      total += presses
      break
    if !visited.add(state): continue
    if target.enumerate().any((i, v) => state[i] > v): continue
    for button in buttons:
      configurations.push(
        state.enumerate().map((i, v) => if i in button then v + 1 else v).to_list(),
        presses + 1
      )
  i += 1

total

# a (0,0,0,1) + b (0,1,0,1) + c (0,0,1,0) + d (0,0,1,1) + e (1,0,1,0) + f (1,1,0,0) = (3,5,4,7)
# 0 + 0 + 0 + 0 + e + f = 3
# 0 + b + 0 + 0 + 0 + f = 5
# 0 + 0 + c + d + e + 0 = 4
# a + b + 0 + d + 0 + 0 = 7

test """
[.##.] (3) (1,3) (2) (2,3) (0,2) (0,1) {3,5,4,7}
[...#.] (0,2,3,4) (2,3) (0,4) (0,1,2) (1,2,3,4) {7,5,12,7,2}
[.###.#] (0,1,2,3,4) (0,3,4) (0,1,2,4,5) (1,2) {10,11,11,5,10,5}
""" == 33
test file("input.txt") == 17133
