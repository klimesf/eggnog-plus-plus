let vertices = [(0, 0)]
let boundary = 0
for line in input.lines():
  let [dir, dist, _] = line.split(" ").to_list()
  boundary += dist.int()
  let step = match dir:
    "U": Up
    "R": Right
    "D": Down
    "L": Left
  vertices.push(vertices.last() + dist.int() * step)

# Shoelace formula, using the fact that the last vertex is the start again
let area = abs(vertices.windows(2)
  .map([(r1, c1), (r2, c2)] => c1 * r2 - r1 * c2)
  .sum()) / 2

# Pick's theorem (area = interior + boundary / 2 - 1)
# We know the area from shoelace formula, so area + boundary / 2 + 1 = interior + boundary)
area + boundary / 2 + 1

test """
R 6 (#70c710)
D 5 (#0dc571)
L 2 (#5713f0)
D 2 (#d2c081)
R 2 (#59c680)
D 2 (#411b91)
L 5 (#8ceee2)
U 2 (#caa173)
L 1 (#1b58a2)
U 2 (#caa171)
R 2 (#7807d2)
U 3 (#a77fa3)
L 2 (#015232)
U 2 (#7a21e3)
""" == 62
test file("input.txt") == 33491
