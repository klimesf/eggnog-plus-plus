fun strength(cards: string) -> [int]:
  let labels = Map(default = 0)
  for c in cards.chars().filter(it != 'J'): labels[c] += 1
  if labels.len() == 0: return [5] # Joker – five of a kind
  let counts = labels.values().to_sorted(desc = true)
  counts[0] += cards.count(it == 'J')
  counts

fun score(hand: string) -> ([int], [int]):
  let (cards, _) = hand.split_once(" ")
  (strength(cards), cards.chars().map(card => "J23456789TQKA".chars().position(it == card)).to_list())

input.lines()
  .to_sorted(by = score(it))
  .enumerate(1)
  .map((rank, hand) => rank * hand.ints().last())
  .sum()

test """
32T3K 765
T55J5 684
KK677 28
KTJJT 220
QQQJA 483
""" == 5905
test file("input.txt") == 254115617
