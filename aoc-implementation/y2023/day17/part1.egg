let grid = input.to_digit_grid()

let queue = MinQueue()
queue.push(((0, 0), Down, 0), 0)
queue.push(((0, 0), Right, 0), 0)
let visited = Set()

while ((pos, dir, blocks), heat_loss) = queue.pop():
  if pos == (grid.rows() - 1, grid.cols() - 1): return heat_loss
  if !visited.add((pos, dir, blocks)): continue
  for nd in Dirs4:
    let np = pos + nd
    if dir == -nd or np !in grid or dir == nd and blocks == 3: continue
    queue.push((np, nd, if dir == nd then blocks + 1 else 1), heat_loss + grid[np])

panic("no path found to machine parts factory")

