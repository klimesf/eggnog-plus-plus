let grid = input.to_char_grid()
let grid2x = Grid(grid.rows() * 2, grid.cols() * 2, '.')
let queue = Queue(grid.find('S'))

fun exits(pos: (int, int)) -> [(int, int)]:
  match grid[pos]:
    '-': [Right, Left]
    '|': [Up, Down]
    'L': [Up, Right]
    'J': [Up, Left]
    'F': [Right, Down]
    '7': [Down, Left]
    'S': Dirs4
    _: []

# find the loop but also create 2x grid for later
while pos = queue.pop():
  if grid2x[2 * pos] == '#': continue
  grid2x[2 * pos] = '#'
  for dir in exits(pos):
    if pos + dir in grid and -dir in exits(pos + dir):
      queue.push(pos + dir)
      grid2x[2 * pos + dir] = '#'

# BFS from outer edges on the 2x grid so you can squeeze between pipes
queue.push_all(grid2x.positions().filter((r, c) => r == 0 or c == 0))
while pos = queue.pop():
  if grid2x[pos] != '.': continue
  grid2x[pos] = 'O' # mark visited in map
  for n in grid2x.neighbors4(pos): queue.push(n)

# count anything from the small grid that the BFS did not touch
grid.positions()
  .filter(grid2x[2 * it] == '.')
  .count()

test """
...........
.S-------7.
.|F-----7|.
.||.....||.
.||.....||.
.|L-7.F-J|.
.|..|.|..|.
.L--J.L--J.
...........
""" == 4
