enum Rule:
  Condition(category: int, op: char, value: int, next: string)
  Send(next: string)

fun parse_rule(rule: string) -> Rule:
  if ":" in rule:
    let (condition, next) = rule.split_once(":")
    let category = "xmas".chars().position(it == condition[0])
    return Condition(category, condition[1], condition[2..].int(), next)
  else: return Send(rule)

let (workflows, _) = input.split_once("\n\n")
let workflows = workflows.lines()
  .map(it[..it.len() - 1].split_once("{"))
  .map((name, rules) => (name, rules.split(",").map(parse_rule(it)).to_list()))
  .to_map()

fun combinations(workflow: string, ranges: [(int, int)]) -> int:
  if workflow == "A": return ranges.map((from, to) => to - from + 1).product()
  if workflow == "R": return 0

  let ans = 0
  let ranges = ranges
  for rule in workflows[workflow]:
    match rule:
      Condition(category, op, value, next):
        let (from, to) = ranges[category]
        let (matching, rest) = match op:
          '<': ((from, value - 1), (value, to))
          '>': ((value + 1, to), (from, value))
        # skip check for negative ranges, AoC input plays nice
        let subranges = ranges
        ranges[category] = rest
        subranges[category] = matching
        ans += combinations(next, subranges)
      Send(next): ans += combinations(next, ranges)
  ans

combinations("in", [(1, 4000)] * 4)

test """
px{a<2006:qkq,m>2090:A,rfg}
