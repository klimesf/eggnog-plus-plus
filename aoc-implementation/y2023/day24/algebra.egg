fun submatrix(matrix: [[int]], row: int, col: int) -> [[int]]:
  matrix.enumerate()
    .filter((i, _) => i != row)
    .map((_, r) => r.enumerate().filter((i, _) => i != col).map((_, c) => c).to_list())
    .to_list()

fun cramer(a: int, b: int, c: int, d: int, e: int, f: int) -> (int, int, int):
  (a * e - b * d, c * e - b * f, a * f - c * d)

fun det2(matrix: [[int]]) -> int:
  matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]

fun det3(matrix: [[int]]) -> int:
  let a11 = matrix[0][0] * det2(submatrix(matrix, 0, 0))
  let a12 = matrix[0][1] * det2(submatrix(matrix, 0, 1))
  let a13 = matrix[0][2] * det2(submatrix(matrix, 0, 2))
  a11 - a12 + a13

fun det4(matrix: [[int]]) -> int:
  let a11 = matrix[0][0] * det3(submatrix(matrix, 0, 0))
  let a12 = matrix[0][1] * det3(submatrix(matrix, 0, 1))
  let a13 = matrix[0][2] * det3(submatrix(matrix, 0, 2))
  let a14 = matrix[0][3] * det3(submatrix(matrix, 0, 3))
  a11 - a12 + a13 - a14

test "submatrix":
  assert submatrix([[1,2,3],[4,5,6],[7,8,9]], 0, 0) == [[5,6],[8,9]]

test "det2":
  assert det2([[0,5],[2,1]]) == -10
  assert det2([[2,5],[3,1]]) == -13

test "det4":
  let matrix = [[2,0,3,-1],[1,-1,2,3],[3,2,0,2],[4,1,5,1]]
  assert det4(matrix) == 35
