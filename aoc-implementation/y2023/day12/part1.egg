fun groups(conditions: string) -> [int]:
  let ctr = 0
  let ans = []
  for c in conditions.chars():
    match c:
      '?': return ans
      '#': ctr += 1
      '.':
        if ctr > 0: ans.push(ctr)
        ctr = 0
  if ctr > 0: ans.push(ctr)
  ans

fun arrangements(conditions: string, sizes: [int]) -> int:
  let groups = groups(conditions)
  if groups.len() > sizes.len(): return 0
  for i in 0..groups.len(): if groups[i] != sizes[i]: return 0
  let remaining = conditions.count('?')
  if remaining == 0: return if groups == sizes then 1 else 0
  if conditions.count('#') + remaining < sizes.sum(): return 0

  let n = conditions.chars().position(it == '?')
  let nc1 = conditions[0..n] + '.' + conditions[n + 1..]
  let nc2 = conditions[0..n] + '#' + conditions[n + 1..]
  arrangements(nc1, sizes) + arrangements(nc2, sizes)

input.lines()
  .map(it.split_once(" "))
  .map((conditions, sizes) => arrangements(conditions, sizes.ints().to_list()))
  .sum()

test """
???.### 1,1,3
.??..??...?##. 1,1,3
?#?#?#?#?#?#?#? 1,3,1,6
????.#...#... 4,1,1
????.######..#####. 1,6,5
?###???????? 3,2,1
""" == 21
test file("input.txt") == 7716
