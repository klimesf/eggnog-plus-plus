fun power(game: string) -> int:
  let [red, green, blue] = [0, 0, 0]
  let (_, sets) = game.split_once(": ")
  for handful in sets.split("; ").flat_map(it.split(", ")):
    let (count, color) = handful.split_once(" ")
    match color:
      "red": red = max(red, count.int())
      "green": green = max(green, count.int())
      "blue": blue = max(blue, count.int())
  return red * green * blue

input.lines()
  .map(power(it))
  .sum()

test """
Game 1: 3 blue, 4 red; 1 red, 2 green, 6 blue; 2 green
Game 2: 1 blue, 2 green; 3 green, 4 blue, 1 red; 1 green, 1 blue
Game 3: 8 green, 6 blue, 20 red; 5 blue, 4 red, 13 green; 5 green, 1 red
Game 4: 1 green, 3 red, 6 blue; 3 green, 6 red; 3 green, 15 blue, 14 red
Game 5: 6 red, 1 blue, 3 green; 2 blue, 1 red, 2 green
""" == 2286
test file("input.txt") == 79315
