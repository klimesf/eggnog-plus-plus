let grid = input.to_char_grid()
let asteroids = grid.positions().filter(grid[it] == '#').to_list()

fun direction(a: (int, int), b: (int, int)) -> (int, int):
  let (dr, dc) = b - a
  let divisor = gcd(dr, dc)
  (dr / divisor, dc / divisor)

fun detect(pos: (int, int)) -> int:
  # count unique directions from the asteroid at pos
  # asteroids in the same direction hide each other
  asteroids.filter(pos != it).map(direction(pos, it)).to_set().len()

asteroids.map(detect(it)).max()

test """
.#..#
.....
#####
....#
...##
""" == 8
