fun intcode(mem: [int], input: Queue<int>) -> [int]:
  let ip = 0
  let mem = mem
  let input = input
  let output = []

  fun param(n: int) -> int:
    let mode = mem[ip] / pow(10, n + 1) % 10
    if mode == 1 then mem[ip + n] else mem[mem[ip + n]]

  fun write(n: int, value: int):
    mem[mem[ip + n]] = value

  while true:
    match mem[ip] % 100:
      1:
        write(3, param(1) + param(2))
        ip += 4
      2:
        write(3, param(1) * param(2))
        ip += 4
      3:
        write(1, input.pop())
        ip += 2
      4:
        output.push(param(1))
        ip += 2
      5:
        if param(1) != 0: ip = param(2)
        else: ip += 3
      6:
        if param(1) == 0: ip = param(2)
        else: ip += 3
      7:
        write(3, if param(1) < param(2) then 1 else 0)
        ip += 4
      8:
        write(3, if param(1) == param(2) then 1 else 0)
        ip += 4
      99: return output
      _: panic("unknown opcode " + mem[ip].to_string())

fun amplify(program: [int], phases: [int]) -> int:
  let signal = 0
  for phase in phases:
    let input = Queue(phase)
    input.push(signal)
    signal = intcode(program, input).last()
  signal

let program = input.ints().to_list()
(0..5).permutations().map(amplify(program, it)).max()

test "3,15,3,16,1002,16,10,16,1,16,15,15,4,15,99,0,0" == 43210
test "3,23,3,24,1002,24,10,24,1002,23,-1,23,101,5,23,23,1,24,23,23,4,23,99,0,0" == 54321
test "3,31,3,32,1002,32,10,32,1001,31,-2,31,1007,31,0,33,1002,33,7,33,1,33,31,31,1,32,31,31,4,31,99,0,0,0" == 65210
test file("input.txt") == 24625
