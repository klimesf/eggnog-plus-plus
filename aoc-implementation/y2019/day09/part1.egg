fun intcode(program: [int], input: Queue<int>) -> [int]:
  let ip = 0
  let rb = 0
  let mem = Map(default = 0)
  for (i, v) in program.enumerate(): mem[i] = v
  let input = input
  let output = []

  fun position(n: int) -> int:
    let mode = mem[ip] / pow(10, n + 1) % 10
    match mode:
      0: mem[ip + n]
      1: ip + n
      2: rb + mem[ip + n]

  fun param(n: int) -> int:
    mem[position(n)]

  fun write(n: int, value: int):
    mem[position(n)] = value

  while true:
    match mem[ip] % 100:
      1:
        write(3, param(1) + param(2))
        ip += 4
      2:
        write(3, param(1) * param(2))
        ip += 4
      3:
        write(1, input.pop())
        ip += 2
      4:
        output.push(param(1))
        ip += 2
      5:
        if param(1) != 0: ip = param(2)
        else: ip += 3
      6:
        if param(1) == 0: ip = param(2)
        else: ip += 3
      7:
        write(3, if param(1) < param(2) then 1 else 0)
        ip += 4
      8:
        write(3, if param(1) == param(2) then 1 else 0)
        ip += 4
      9:
        rb += param(1)
        ip += 2
      99: return output
      _: panic("unknown opcode " + mem[ip].to_string())

intcode(input.ints().to_list(), Queue(1)).last()

test "intcode":
  let program = "109,1,204,-1,1001,100,1,100,1008,100,16,101,1006,101,0,99".ints().to_list()
  intcode(program, Queue()) == program

test "104,1125899906842624,99" == 1125899906842624
test "1102,34915192,34915192,7,4,7,99,0" == 1219070632396864
test file("input.txt") == 3345854957
