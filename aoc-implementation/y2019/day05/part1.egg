fun intcode(mem: [int], input: Queue<int>) -> [int]:
  let ip = 0
  let mem = mem
  let input = input
  let output = []

  fun param(n: int) -> int:
    let mode = mem[ip] / pow(10, n + 1) % 10
    if mode == 1 then mem[ip + n] else mem[mem[ip + n]]

  fun write(n: int, value: int):
    mem[mem[ip + n]] = value

  while true:
    match mem[ip] % 100:
      1:
        write(3, param(1) + param(2))
        ip += 4
      2:
        write(3, param(1) * param(2))
        ip += 4
      3:
        write(1, input.pop())
        ip += 2
      4:
        output.push(param(1))
        ip += 2
      99: return output
      _: panic("unknown opcode " + mem[ip].to_string())

intcode(input.ints().to_list(), Queue(1)).last()

test "intcode":
  assert intcode("3,0,4,0,99".ints().to_list(), Queue(1234)).last() == 1234

test file("input.txt") == 15508323
