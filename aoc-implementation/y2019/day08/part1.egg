fun check_corruption(image: string, width: int, height: int) -> int:
  let layer = image.chars()
    .chunks(width * height)
    .to_sorted(by = layer => layer.count(it == '0'))
    .first()
  layer.count(it == '1') * layer.count(it == '2')

check_corruption(input, 25, 6)

test "check corruption":
  assert check_corruption("123456789012", 3, 2) == 1

test file("input.txt") == 1441
