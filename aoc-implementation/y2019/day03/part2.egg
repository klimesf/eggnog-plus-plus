fun steps_to(path: string) -> Map<(int, int), int>:
  let steps = Map()
  let point = (0, 0)
  let step = 0
  for move in path.split(","):
    let dir = match move[0]:
      'R': Right
      'L': Left
      'U': Up
      'D': Down
    for _ in 0..move[1..].int():
      point += dir
      step += 1
      if point !in steps: steps[point] = step
  steps

let [a, b] = input.lines().map(steps_to(it)).to_list()
a.keys().filter(it in b).map(p => a[p] + b[p]).min()

test """
R8,U5,L5,D3
U7,R6,D4,L4
""" == 30
test """
R75,D30,R83,U83,L12,D49,R71,U7,L72
U62,R66,U55,R34,D71,R55,D58,R83
""" == 610
test """
R98,U47,R26,D63,R33,U87,L62,D20,R33,U53,R51
U98,R91,D20,R16,D67,R40,U7,R15,U6,R7
""" == 410
test file("input.txt") == 65356
