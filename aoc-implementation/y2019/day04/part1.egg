fun meets(password: int) -> bool:
  let digits = password.digits().to_list()
  if digits.windows(2).any([a, b] => a > b): return false
  if digits.windows(2).all([a, b] => a != b): return false
  true

# generates a list of non-decreasing passwords
fun generate(password: int, len: int) -> [int]:
  if len == 6: return [password]
  let last = password % 10
  (last..=9).flat_map(generate(password * 10 + it, len + 1)).to_list()

let [from, to] = input.ints().to_list()
(1..=9).flat_map(generate(it, 1)).count(from <= it and it <= to and meets(it))

test "meets":
  assert meets(111111) == true
  assert meets(223450) == false
  assert meets(123789) == false

test file("input.txt") == 1955
