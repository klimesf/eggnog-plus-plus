{
  "scopeName": "markdown.eggnog.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#eggnog-code-block" }],
  "repository": {
    "eggnog-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(egg|eggnog)(\\s+[^`~]*)?$)",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.eggnog",
          "patterns": [{ "include": "source.eggnog" }]
        }
      ]
    }
  }
}
