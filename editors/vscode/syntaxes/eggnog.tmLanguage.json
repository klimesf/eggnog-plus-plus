{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "eggnog++",
  "scopeName": "source.eggnog",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#char"
    },
    {
      "include": "#number"
    },
    {
      "include": "#fn-def"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#method"
    },
    {
      "include": "#type"
    },
    {
      "include": "#call"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.eggnog"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.eggnog",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.eggnog"
        }
      ]
    },
    "char": {
      "match": "'(\\\\.|[^'\\\\])'",
      "name": "string.quoted.single.eggnog"
    },
    "number": {
      "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9_]+)?([eE][+-]?[0-9]+)?)\\b",
      "name": "constant.numeric.eggnog"
    },
    "fn-def": {
      "match": "\\b(fn|fun)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.function.eggnog"
        },
        "2": {
          "name": "entity.name.function.eggnog"
        }
      }
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(if|then|else|while|for|in|match|return|break|continue|test|assert)\\b",
          "name": "keyword.control.eggnog"
        },
        {
          "match": "\\b(let|fn|fun|memo|inout|struct|enum)\\b",
          "name": "keyword.declaration.eggnog"
        },
        {
          "match": "\\b(and|or|not|as)\\b",
          "name": "keyword.operator.expression.eggnog"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.eggnog"
        },
        {
          "match": "\\b(input|it)\\b",
          "name": "variable.language.eggnog"
        },
        {
          "match": "\\b(Up|Right|Down|Left|Dirs4|Dirs8|[A-Z][A-Z0-9_]+)\\b|(?<=::)(Max|Min)\\b",
          "name": "variable.other.constant.eggnog"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "match": "\\b(int|float|char|string|bool)\\b",
          "name": "support.type.primitive.eggnog"
        },
        {
          "match": "\\b[A-Z][A-Za-z0-9]*\\b",
          "name": "entity.name.type.eggnog"
        }
      ]
    },
    "call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.eggnog"
        }
      }
    },
    "operator": {
      "patterns": [
        {
          "match": "!in\\b",
          "name": "keyword.operator.expression.eggnog"
        },
        {
          "match": "=>|\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|->|\\.\\.=?|[-+*/%<>=!]",
          "name": "keyword.operator.eggnog"
        }
      ]
    },
    "method": {
      "match": "(?<=\\.)\\s*([a-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "entity.name.function.member.eggnog"
        }
      }
    }
  }
}
